{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
      "opencode-subagent-magazine@latest"
  ],

  // TUI-only overrides tuned to feel closer to Claude Code.
  // In terminals, Command/Cmd usually cannot be captured reliably,
  // so Alt is used where Claude Code often uses Cmd/Option.
  "keybinds": {
    "leader": "ctrl+n",

    "app_exit": "<leader>q",
    "session_interrupt": "ctrl+c,escape",
    "input_clear": "<leader>l",

    "editor_open": "ctrl+g",
    "display_thinking": "ctrl+o",
    "model_list": "<leader>m",
    "command_list": "ctrl+p",

    "input_submit": "return",
    "input_newline": "ctrl+return,shift+return,alt+return,ctrl+j",
    "input_delete_to_line_end": "ctrl+k",
    "input_delete_to_line_start": "none",
    "input_delete": "delete,shift+delete",
    "input_word_backward": "alt+b,alt+left,ctrl+left",
    "input_word_forward": "alt+f,alt+right,ctrl+right",

    "agent_cycle": "none",
    "agent_cycle_reverse": "shift+tab",
    "dialog.select.next": "down",
    "prompt.autocomplete.next": "down",
    "session_child_first": "<leader>j",
    "session_parent": "<leader>k",
    "session_child_cycle": "<leader>l",
    "session_child_cycle_reverse": "<leader>h",

    "messages_page_up": "none",
    "messages_page_down": "none",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
    "messages_first": "home",
    "messages_last": "end",
    "messages_previous": "alt+k",
    "messages_next": "alt+j",
    "messages_last_user": "alt+u"
  }
}
