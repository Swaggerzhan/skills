{
  "$schema": "https://opencode.ai/config.json",

  // Claude Code routes its Opus alias to sol and its lightweight work to terra.
  "model": "OpenAI/gpt-5.6-sol",
  "small_model": "OpenAI/gpt-5.6-terra",
  "default_agent": "Main",
  "enabled_providers": ["OpenAI", "xAI", "DeepSeek", "Kimi"],

  "provider": {
    "OpenAI": {
      "name": "OpenAI",
      // Use the Responses API so this provider preserves reasoning effort "max".
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "{env:OPENCODE_OPENAI_ENDPOINT}",
        "apiKey": "{env:OPENCODE_OPENAI_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "xAI": {
      "name": "xAI",
      // The SDK package identifies the API protocol, not the model vendor.
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "{env:OPENCODE_XAI_ENDPOINT}",
        "apiKey": "{env:OPENCODE_XAI_KEY}"
      },
      "models": {
        "grok-4.5": {
          "name": "Grok 4.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    },
    "DeepSeek": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "{env:OPENCODE_DEEPSEEK_ENDPOINT}",
        "apiKey": "{env:OPENCODE_DEEPSEEK_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "tool_call": true,
          "options": {
            "reasoningEffort": "max"
          },
          // OpenCode maps @ai-sdk/openai reasoning models to the OpenAI
          // effort scale (low/medium/high). Disable those so DeepSeek V4 Pro
          // defaults to its actual "max" effort and stops prompting for one.
          "variants": {
            "low": { "disabled": true },
            "medium": { "disabled": true },
            "high": { "disabled": true },
            "max": { "reasoningEffort": "max" }
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "tool_call": true,
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low": { "disabled": true },
            "medium": { "disabled": true },
            "high": { "disabled": true },
            "max": { "reasoningEffort": "max" }
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    },
    "Kimi": {
      "name": "Kimi",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "{env:OPENCODE_KIMI_ENDPOINT}",
        "apiKey": "{env:OPENCODE_KIMI_KEY}"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          "reasoning": true,
          "tool_call": true,
          "options": {
            "effort": "max"
          },
          "limit": {
            "context": 1000000,
            "output": 1048576
          }
        }
      }
    }
  },

  // Reserve 20K tokens so automatic compaction starts near 280K.
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 20000
  },

  // OpenCode uses last-match-wins semantics for pattern rules.
  "permission": {
    "read": {
      "*": "allow",
      "build/**": "deny",
      "nvim.root/**": "deny",
      "gflag_change_history.md": "deny",
      "global_compile_flags.json.md": "deny",
      "release.bcloud": "deny",
      "run.py": "deny",
      "toolserver/**": "deny",
      ".bcloud.cache/**": "deny"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "git": "deny",
    "openspec": "deny",
    "simple_run": "deny",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "shutdown *": "deny",
      "reboot": "deny",
      "poweroff": "deny",
      "halt": "deny",
      "init *": "deny",
      "su *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "iptables *": "deny",
      "git push --force *": "deny",
      "git reset --hard *": "deny",
      "git clean -f*": "deny"
    },
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "doom_loop": "ask"
  },

  "agent": {
    "title": {
      "model": "DeepSeek/deepseek-v4-flash",
      "variant": "max",
      // OpenCode 1.17.20 ignores variants on small-model requests.
      "options": {
        "reasoningEffort": "max"
      },
      "steps": 1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },

  // No MCP server is active for the current project.
  "mcp": {
    "dep_search": {
      "type": "local",
      "command": [
        "/tools/bin/codebase-memory-mcp",
        "--tool-profile=analysis"
      ]
    }
  },

  // Claude Code has no active formatter configuration to migrate.
  "formatter": false
}
